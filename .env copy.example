# Copy this file to ".env" (same folder). Defaults below match a fresh XAMPP
# install — you usually only need to change DB_NAME if you named your
# database something else in phpMyAdmin.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=equipment_borrowing_system
DB_USER=root
DB_PASSWORD=

# Local timezone used for borrowing date restrictions.
APP_TIMEZONE=Asia/Manila
